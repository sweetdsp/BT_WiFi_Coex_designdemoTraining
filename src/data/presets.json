{
  "_note": "Preset scenarios: the five worked examples of spec 7A.12 (FR-22b, AC-6). Platform values override the defaults in platformDefaults.json. The Example 1 Wi-Fi video bitrate (150 Mbps) is chosen so the stream is near continuous, which the example needs.",
  "presets": [
    {
      "id": "example-1",
      "example": 1,
      "name": "Example 1: A2DP and Wi-Fi 7 on a shared antenna",
      "summary": "A2DP at 328 kbps shares one antenna with a Wi-Fi 7 video stream. Wi-Fi wins until A2DP has four packets waiting, then A2DP becomes critical.",
      "label": "IMPLEMENTATION_VARIES",
      "tasks": [
        {
          "taskId": "bt_a2dp",
          "params": {
            "bitrateKbps": 328,
            "packetType": "2-DH5"
          }
        },
        {
          "taskId": "wifi_video_stream",
          "params": {
            "bitrateMbps": 150
          }
        }
      ],
      "platform": {
        "wifiGeneration": "11be",
        "wifiBand": "2.4",
        "wifiChannel": 6,
        "wifiBandwidth": 20,
        "antennaMode": "SHARED",
        "femArrangement": "SHARED_SWITCH",
        "coreCount": 1,
        "coreMode": "TIME_DIVISION",
        "arbitrationPolicy": "PRIORITY",
        "afhEnabled": false,
        "windowUs": 100000,
        "seed": 1
      }
    },
    {
      "id": "example-2",
      "example": 2,
      "name": "Example 2: separate antennas and 40 dB isolation",
