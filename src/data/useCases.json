    {
      "id": "thread-sleepy-sensor",
      "name": "Smart-home sensor (sleepy device)",
      "description": "A battery sensor that polls its parent and reports a reading.",
      "tech": "THREAD",
      "tasks": [
        {
          "taskId": "thread_poll",
          "params": {
            "pollPeriodMs": 50,
            "dataPending": true
          }
        },
        {
          "taskId": "thread_report",
          "params": {
            "reportIntervalMs": 50,
            "payloadBytes": 30
          }
        }
      ]
    },
    {
      "id": "thread-border-router",
      "name": "Router with border-router traffic",
      "description": "A router forwarding frames for the mesh, with its advertisements.",
      "tech": "THREAD",
      "tasks": [
        {
          "taskId": "thread_forward",
          "params": {
            "framesPerSec": 20
          }
        },
        {
          "taskId": "thread_mle",
          "params": {
            "advertIntervalS": 0.05
          }
        }
      ]
    },
    {
      "id": "thread-join",
      "name": "Joining a new device",
      "description": "A new device scans for a network, then attaches to a parent.",
      "tech": "THREAD",
      "tasks": [
        {
          "taskId": "thread_scan",
          "params": {
            "scanChannels": "15,20,25,26",
            "dwellMs": 15
          }
        },
        {
          "taskId": "thread_attach",
          "params": {
            "startMs": 200
          }
        }
      ]
    },
    {
      "id": "thread-firmware",
      "name": "Firmware update over Thread",
      "description": "A long run of full-size frames to one device.",
      "tech": "THREAD",
      "tasks": [
        {
          "taskId": "thread_bulk",
          "params": {}
        }
      ]
    },
    {
      "id": "thread-csl",
      "name": "Scheduled listening (Thread 1.2)",
