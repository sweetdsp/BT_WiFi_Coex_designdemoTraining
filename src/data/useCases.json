      "tech": "THREAD",
      "tasks": [
        {
          "taskId": "thread_csl",
          "params": {
            "cslPeriodMs": 50
          }
        },
        {
          "taskId": "thread_report",
          "params": {
            "reportIntervalMs": 50
          }
        }
      ]
